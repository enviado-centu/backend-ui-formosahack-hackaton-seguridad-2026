# Copiá este archivo a .env y completá los valores. .env está en .gitignore: nunca lo commitees.

APP_NAME=Phishing Detection API
APP_VERSION=0.1.0
# development | production (en production el backend no arranca sin SECRET_KEY)
ENVIRONMENT=development
DEBUG=false

# PostgreSQL: docker-compose y scripts/crear_db_local.sql usan estos valores
POSTGRES_USER=detector
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=detector
# Si ya tenés un PostgreSQL local en el 5432 y usás Docker, poné 5433 (y cambiá el puerto abajo)
POSTGRES_PORT=5432

# Misma clave que POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://detector:cambiame@localhost:5432/detector
# Base separada para los tests (si no responde, los tests usan SQLite en memoria)
TEST_DATABASE_URL=postgresql+asyncpg://detector:cambiame@localhost:5432/detector_test

# Seguridad: generá una con
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si queda vacía en development, el backend genera una temporal (los tokens se invalidan al reiniciar).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Kev
KEV_BASE_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
KEV_TIMEOUT=3
# Carpeta del repo kev-integration (vacío: se busca al lado del backend como kev-integration o kev_integration)
KEV_INTEGRATION_PATH=

# CORS (lista JSON con los orígenes del frontend)
CORS_ORIGINS=["http://localhost:5173"]

# Límites
MAX_PAYLOAD_SIZE=10485760
# Límite de pedidos de /public/* por IP y por minuto (en memoria, por proceso)
PUBLIC_RATE_LIMIT_PER_MIN=60
